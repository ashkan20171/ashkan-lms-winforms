<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings><add key="PersistenceMode" value="Json" /></appSettings>
  <connectionStrings>
    <add name="AshkanLMS" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=AshkanLMS;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Connect Timeout=10" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true"><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
</configuration>
